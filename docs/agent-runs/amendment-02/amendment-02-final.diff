+                if [ "${s:$i:1}" = "$c2" ] && [ "${s:$((i + 1)):1}" = ']' ]; then break; fi
+                i=$((i + 1))
+              done
+              [ "$i" -ge "$n" ] && return 1
+              i=$((i + 2)); continue ;;
+          esac
+        fi
+        i=$((i + 1))
+      done
+      continue
+    fi
+    i=$((i + 1))
