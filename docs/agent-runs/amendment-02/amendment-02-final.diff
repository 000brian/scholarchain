+      [ "${s:$i:1}" = '^' ] && i=$((i + 1))
+      [ "${s:$i:1}" = ']' ] && i=$((i + 1))
+      while [ "$i" -lt "$n" ]; do
+        ch="${s:$i:1}"
+        if [ "$ch" = ']' ]; then i=$((i + 1)); break; fi
+        [ "$ch" = "$NL" ] && return 1
