{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(sbt check)",
      "Bash(sbt clean check)",
      "Bash(sbt fmt)",
      "Bash(sbt test)",
      "Bash(sbt Test/compile)",
      "Bash(sbt scalafmtCheckAll)",
      "Bash(bash -n:*)",
      "Bash(shellcheck:*)",
      "Bash(jq empty:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(.claude/hooks/validate-agent-files.sh)",
      "Bash(terraform fmt -check:*)",
      "Bash(terraform fmt -recursive -check:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform version)",
      "Bash(aws sts get-caller-identity:*)",
      "WebFetch(domain:dblp.org)",
      "WebFetch(domain:docs.openalex.org)",
      "WebFetch(domain:help.openalex.org)",
      "WebFetch(domain:download.opencitations.net)",
      "WebFetch(domain:www.crossref.org)",
      "WebFetch(domain:info.arxiv.org)",
      "WebFetch(domain:info.orcid.org)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:developer.hashicorp.com)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(gh release:*)",
      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(scripts/plan.sh:*)",
      "Bash(./scripts/plan.sh:*)",
      "Bash(scripts/deploy.sh:*)",
      "Bash(./scripts/deploy.sh:*)",
      "Bash(bash scripts/deploy.sh:*)",
      "Bash(scripts/rollback.sh:*)",
      "Bash(./scripts/rollback.sh:*)",
      "Bash(bash scripts/rollback.sh:*)",
      "Bash(scripts/smoke-test.sh:*)",
      "Bash(./scripts/smoke-test.sh:*)",
      "Bash(scripts/run-bounded-pipeline.sh:*)",
      "Bash(./scripts/run-bounded-pipeline.sh:*)",
      "Bash(bash scripts/run-bounded-pipeline.sh:*)",
      "Bash(scripts/run-experiment.sh:*)",
      "Bash(./scripts/run-experiment.sh:*)",
      "Bash(bash scripts/run-experiment.sh:*)",
      "Bash(scripts/cleanup.sh:*)",
      "Bash(./scripts/cleanup.sh:*)",
      "Bash(bash scripts/cleanup.sh:*)",
      "Bash(docker push:*)",
      "Bash(brew install:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(uv tool install:*)",
      "Bash(cs install:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.netrc)",
      "Read(**/*credentials*.json)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.envrc)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.*)",
      "Edit(./.claude/.last-test-run)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/.envrc)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.tfstate)",
      "Write(**/*.tfstate.*)",
      "Write(./.claude/.last-test-run)",
      "Bash(cat .env:*)",
      "Bash(printenv:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws configure export-credentials:*)",
      "Bash(gh auth token:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(terragrunt apply:*)",
      "Bash(terragrunt destroy:*)",
      "Bash(terragrunt run-all apply:*)",
      "Bash(terragrunt run-all destroy:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state push:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin --force-with-lease:*)",
      "Bash(git push origin +:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3api delete-bucket:*)",
      "Bash(aws s3api delete-object:*)",
      "Bash(aws s3api delete-objects:*)",
      "Bash(aws s3api put-bucket-lifecycle-configuration:*)",
      "Bash(aws dynamodb delete-table:*)",
      "Bash(aws dynamodb delete-item:*)",
      "Bash(aws dynamodb delete-backup:*)",
      "Bash(aws dynamodb batch-write-item:*)",
      "Bash(aws neptune delete-db-cluster:*)",
      "Bash(aws neptune delete-db-instance:*)",
      "Bash(aws neptune delete-db-cluster-snapshot:*)",
      "Bash(aws neptune-graph delete-graph:*)",
      "Bash(aws neptunedata delete-propertygraph-statistics:*)",
      "Bash(aws s3vectors delete-vector-bucket:*)",
      "Bash(aws s3vectors delete-index:*)",
      "Bash(aws s3vectors delete-vectors:*)",
      "Bash(aws ecr delete-repository:*)",
      "Bash(aws ecr batch-delete-image:*)",
      "Bash(aws ecr delete-lifecycle-policy:*)",
      "Bash(aws kms schedule-key-deletion:*)",
      "Bash(aws kms disable-key:*)",
      "Bash(aws kms delete-alias:*)",
      "Bash(aws kms delete-imported-key-material:*)",
      "Bash(aws emr terminate-clusters:*)",
      "Bash(aws emr modify-instance-groups:*)",
      "Bash(aws emr modify-instance-fleet:*)",
      "Bash(aws emr add-instance-groups:*)",
      "Bash(aws emr add-instance-fleet:*)",
      "Bash(aws emr put-managed-scaling-policy:*)",
      "Bash(aws emr remove-managed-scaling-policy:*)",
      "Bash(aws emr set-termination-protection:*)",
      "Bash(aws opensearch delete-domain:*)",
      "Bash(aws opensearchserverless delete-collection:*)",
      "Bash(aws secretsmanager delete-secret:*)",
      "Bash(aws cloudformation delete-stack:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(aws ecs delete-service:*)",
      "Bash(aws ecs delete-cluster:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-dangerous.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-scala.sh",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-agent-files.sh --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-tests-ran.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-tests-ran.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
