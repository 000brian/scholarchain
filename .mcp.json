{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm", "--read-only",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e", "GITHUB_READ_ONLY",
        "-e", "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server@sha256:f6056fc10bfffcc8c81a6417a2e9ca12808647e8dd6049642a4feaadee0e0f8a"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${SCHOLARCHAIN_GITHUB_READONLY_TOKEN}",
        "GITHUB_READ_ONLY": "1",
        "GITHUB_TOOLSETS": "repos,issues,pull_requests"
      }
    },
    "aws-api": {
      "command": "uvx",
      "args": ["--python", "3.12", "--with", "mcp<2", "awslabs.aws-api-mcp-server@1.3.33"],
      "env": {
        "AWS_API_MCP_PROFILE_NAME": "${SCHOLARCHAIN_AWS_READONLY_PROFILE}",
        "AWS_REGION": "${SCHOLARCHAIN_AWS_REGION}",
        "READ_OPERATIONS_ONLY": "true",
        "REQUIRE_MUTATION_CONSENT": "true",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "terraform": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "--read-only", "hashicorp/terraform-mcp-server@sha256:11dd418bba6003dd5777e9d0979b68de59929a155b355f338f407947e00e9d80"]
    },
    "aws-docs": {
      "command": "uvx",
      "args": ["--python", "3.12", "--with", "mcp<2", "awslabs.aws-documentation-mcp-server@1.1.21"],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
