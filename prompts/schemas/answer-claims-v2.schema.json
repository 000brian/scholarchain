{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarchain.example.invalid/schemas/answer-claims-v2",
  "title": "ScholarChain answer claims, version 2",
  "description": "Output of answer synthesis (prompt answer-synthesis-v2). Validated by org.scholarchain.rag.runtime.AnswerClaimsSchema (spec V2), then every claim is checked by the deterministic ClaimVerification stage. Differences from v1: at most 15 claims, claim text at most 300 characters, at most 10 numbers per claim, and every entry of a claim's numbers must appear as a number in that claim's text (checked in code). summary and missingEvidence must contain no digits and no identifiers (checked in code).",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "claims", "missingEvidence"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "claims": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "text", "evidenceIds", "numbers", "uncertainty"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^claim-[0-9]{1,4}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 },
          "evidenceIds": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^evidence:v1:[0-9a-f]{32}$" }
          },
          "numbers": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "evidenceId", "field"],
              "properties": {
                "value": { "type": "number" },
                "evidenceId": { "type": "string", "pattern": "^evidence:v1:[0-9a-f]{32}$" },
                "field": {
                  "type": "string",
                  "enum": [
                    "value",
                    "rank",
                    "weight",
                    "jointPublicationCount",
                    "firstYear",
                    "lastYear",
                    "hops",
                    "maxDepth",
                    "depthSearched",
                    "year",
                    "teamSize",
                    "confidence",
                    "publicationCount",
                    "distinctCoauthors",
                    "windowStartYear",
                    "windowEndYear"
                  ]
                }
              }
            }
          },
          "uncertainty": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
